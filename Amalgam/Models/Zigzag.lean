import Amalgam.System.Binary
import Amalgam.System.Comparison

/-!
# Calibration case 2: the Section 12 witness on `L → B ← M → D ← R`

The finite witness of PROPOSAL Section 12, certified with the finite-family theory. The five-point
preorder `Context` has `B ≤ L`, `B ≤ M`, `D ≤ M`, `D ≤ R`; `B` is the greatest common coarser
context of `L`, `M`, `D` that of `M`, `R`, and `L`, `R` have no common coarser context. Every fine
system has singleton states at `L`, `M`, `R` and two-point states at `B`, `D`, and is determined by
its four restriction values listed in the arrow order

```text
L→B, M→B, M→D, R→D
```

(`sys lb mb md rd`). The two systems of the witness are `sysA = sys (0, 0, 0, 1)` and
`sysB = sys (0, 1, 0, 0)` with `0 = false`, `1 = true`. The coarse system `coarse` has singleton
states everywhere, and the observations `φA`, `φB` are the unique maps, which are surjective at
every context (`surjective_φA`, `surjective_φB`) and commute with restriction on the nose.

The declared admissible datum is the families `LM = ![L, M]`, `MR = ![M, R]`, `LMR = ![L, M, R]`
with the declared restriction operations `toLM : FamilyMap LMR LM` and `toMR : FamilyMap LMR MR`
forgetting one view. Compatibility over each family reduces to equations between restriction
values (`compatible_LM_iff`, `compatible_MR_iff`, `compatible_LMR_iff`), which certify the
table of attainable images:

```text
System  Restriction values   I_LM       I_MR       I_LMR
A       (0, 0, 0, 1)         univ       ∅          ∅
B       (0, 1, 0, 0)         ∅          univ       ∅
```

Here `univ` is the singleton of coarse families (`uniqueCoarseFamily`). Consequently restriction
of attainable images is strictly included (`ssubset_restrict_image_LMR_A`,
`ssubset_restrict_image_LMR_B`), and the two systems have equal full-family content
(`image_LMR_eq`) but different `LM` and `MR` content (`image_LM_ne`, `image_MR_ne`).

No smallest-shape claim is made, and no M3 datum is refuted: the witness separates full-family
content from all-family content and nothing more.
-/

namespace Amalgam.Models.Zigzag

/-- The shared-overlap shape `L → B ← M → D ← R`. -/
inductive Context
  /-- The left context. -/
  | L
  /-- The overlap of `L` and `M`. -/
  | B
  /-- The middle context. -/
  | M
  /-- The overlap of `M` and `R`. -/
  | D
  /-- The right context. -/
  | R

namespace Context

/-- The order generated by `B ≤ L`, `B ≤ M`, `D ≤ M`, `D ≤ R` and reflexivity, `c ≤ d` reading
`c` coarser. -/
def le : Context → Context → Prop
  | L, L => True
  | B, B => True
  | B, L => True
  | B, M => True
  | M, M => True
  | D, D => True
  | D, M => True
  | D, R => True
  | R, R => True
  | _, _ => False

instance : Preorder Context where
  le := le
  le_refl a := by cases a <;> trivial
  le_trans a b c _ _ := by cases a <;> cases b <;> cases c <;> trivial

/-- `B` is coarser than `L`. -/
theorem B_le_L : B ≤ L := trivial

/-- `B` is coarser than `M`. -/
theorem B_le_M : B ≤ M := trivial

/-- `D` is coarser than `M`. -/
theorem D_le_M : D ≤ M := trivial

/-- `D` is coarser than `R`. -/
theorem D_le_R : D ≤ R := trivial

/-- `B` is the greatest common coarser context of `L` and `M`. -/
theorem le_B_of_le_L_of_le_M : ∀ ⦃c : Context⦄, c ≤ L → c ≤ M → c ≤ B := by
  intro c _ _
  cases c <;> trivial

/-- `D` is the greatest common coarser context of `M` and `R`. -/
theorem le_D_of_le_M_of_le_R : ∀ ⦃c : Context⦄, c ≤ M → c ≤ R → c ≤ D := by
  intro c _ _
  cases c <;> trivial

/-- `L` and `R` have no common coarser context. -/
theorem not_le_L_of_le_R : ∀ ⦃c : Context⦄, c ≤ L → c ≤ R → False := by
  intro c _ _
  cases c <;> trivial

end Context

open Context

/-! ### The fine systems -/

/-- Fine state types: singletons at `L`, `M`, `R` and two-point overlaps at `B`, `D`. -/
def State : Context → Type
  | L => Unit
  | B => Bool
  | M => Unit
  | D => Bool
  | R => Unit

/-- Fine restriction with values `lb`, `mb`, `md`, `rd` on the arrows `L→B`, `M→B`, `M→D`,
`R→D`; the identity on every context and the unique map into a singleton. -/
def res (lb mb md rd : Bool) : ∀ {c d : Context}, c ≤ d → State d → State c
  | L, _, _, _ => ()
  | M, _, _, _ => ()
  | R, _, _, _ => ()
  | B, B, _, x => x
  | B, L, _, _ => lb
  | B, M, _, _ => mb
  | B, D, h, _ => False.elim h
  | B, R, h, _ => False.elim h
  | D, D, _, x => x
  | D, M, _, _ => md
  | D, R, _, _ => rd
  | D, L, h, _ => False.elim h
  | D, B, h, _ => False.elim h

/-- The fine restriction system with restriction values `(lb, mb, md, rd)` in the arrow order
`L→B, M→B, M→D, R→D`. -/
def sys (lb mb md rd : Bool) : RestrictionSystem Context where
  State := State
  res := res lb mb md rd
  res_refl := by
    intro c h x
    cases c <;> rfl
  res_trans := by
    intro c d e h₁ h₂ x
    cases c <;> cases d <;> cases e <;> first | rfl | exact False.elim h₁ | exact False.elim h₂

/-- System A of the witness table: restriction values `(0, 0, 0, 1)`. -/
abbrev sysA : RestrictionSystem Context := sys false false false true

/-- System B of the witness table: restriction values `(0, 1, 0, 0)`. -/
abbrev sysB : RestrictionSystem Context := sys false true false false

/-- A fine state at every context. -/
def point : ∀ c, State c
  | L => ()
  | B => false
  | M => ()
  | D => false
  | R => ()

/-! ### The coarse system and the observations -/

/-- The coarse restriction system: one state at every context. -/
def coarse : RestrictionSystem Context where
  State _ := Unit
  res _ _ := ()
  res_refl _ _ := rfl
  res_trans _ _ _ := rfl

/-- Over any family of contexts the coarse compatible families form a singleton. -/
instance uniqueCoarseFamily {ι : Type*} (F : ι → Context) :
    Unique (coarse.CompatibleFamily F) where
  default := ⟨fun _ => (), fun _ _ _ _ _ => rfl⟩
  uniq _ := Subtype.ext (funext fun _ => rfl)

/-- The observation of a fine system: the unique map at every context; naturality holds on the
nose. -/
def hom (lb mb md rd : Bool) : (sys lb mb md rd).Hom coarse where
  toFun _ _ := ()
  naturality _ _ := rfl

/-- Every component observation is surjective, hit by `point`. -/
theorem surjective_hom (lb mb md rd : Bool) (c : Context) :
    Function.Surjective ((hom lb mb md rd).toFun c) :=
  fun _ => ⟨point c, rfl⟩

/-- The observation of system A. -/
abbrev φA : sysA.Hom coarse := hom false false false true

/-- The observation of system B. -/
abbrev φB : sysB.Hom coarse := hom false true false false

/-- Every component observation of system A is surjective. -/
theorem surjective_φA : ∀ c, Function.Surjective (φA.toFun c) := surjective_hom _ _ _ _

/-- Every component observation of system B is surjective. -/
theorem surjective_φB : ∀ c, Function.Surjective (φB.toFun c) := surjective_hom _ _ _ _

/-! ### The admissible datum -/

/-- The family `![L, M]`. -/
abbrev LM : Fin 2 → Context := ![L, M]

/-- The family `![M, R]`. -/
abbrev MR : Fin 2 → Context := ![M, R]

/-- The full family `![L, M, R]`. -/
abbrev LMR : Fin 3 → Context := ![L, M, R]

/-- The declared restriction operation forgetting the view `R`. -/
def toLM : FamilyMap LMR LM :=
  ⟨![0, 1], fun k => match k with | 0 => le_rfl | 1 => le_rfl⟩

/-- The declared restriction operation forgetting the view `L`. -/
def toMR : FamilyMap LMR MR :=
  ⟨![1, 2], fun k => match k with | 0 => le_rfl | 1 => le_rfl⟩

/-! ### Compatibility over each family -/

/-- A family over `![L, M]` is compatible exactly when the values on `L→B` and `M→B` agree, by
`compatible_pair_iff` at the greatest common coarser context `B`. -/
theorem compatible_LM_iff (lb mb md rd : Bool) (x : ∀ i, State (LM i)) :
    (sys lb mb md rd).Compatible LM x ↔ lb = mb :=
  (sys lb mb md rd).compatible_pair_iff B_le_L B_le_M le_B_of_le_L_of_le_M x

/-- A family over `![M, R]` is compatible exactly when the values on `M→D` and `R→D` agree, by
`compatible_pair_iff` at the greatest common coarser context `D`. -/
theorem compatible_MR_iff (lb mb md rd : Bool) (x : ∀ i, State (MR i)) :
    (sys lb mb md rd).Compatible MR x ↔ md = rd :=
  (sys lb mb md rd).compatible_pair_iff D_le_M D_le_R le_D_of_le_M_of_le_R x

/-- A family over `![L, M, R]` is compatible exactly when both overlap equations hold, by
`compatible_triple_iff`. -/
theorem compatible_LMR_iff (lb mb md rd : Bool) (x : ∀ i, State (LMR i)) :
    (sys lb mb md rd).Compatible LMR x ↔ lb = mb ∧ md = rd :=
  (sys lb mb md rd).compatible_triple_iff B_le_L B_le_M D_le_M D_le_R le_B_of_le_L_of_le_M
    le_D_of_le_M_of_le_R not_le_L_of_le_R x

/-! ### The witness table: fine families -/

/-- System A has a compatible family over `![L, M]`: both values at `B` are `0`. -/
theorem nonempty_LM_A : Nonempty (sysA.CompatibleFamily LM) :=
  ⟨⟨fun i => point (LM i), (compatible_LM_iff _ _ _ _ _).2 rfl⟩⟩

/-- System A has no compatible family over `![M, R]`: the values at `D` are `0` and `1`. -/
theorem isEmpty_MR_A : IsEmpty (sysA.CompatibleFamily MR) :=
  ⟨fun x => Bool.false_ne_true ((compatible_MR_iff _ _ _ _ _).1 x.2)⟩

/-- System A has no compatible family over `![L, M, R]`: the `MR` equation fails. -/
theorem isEmpty_LMR_A : IsEmpty (sysA.CompatibleFamily LMR) :=
  ⟨fun x => Bool.false_ne_true ((compatible_LMR_iff _ _ _ _ _).1 x.2).2⟩

/-- System B has no compatible family over `![L, M]`: the values at `B` are `0` and `1`. -/
theorem isEmpty_LM_B : IsEmpty (sysB.CompatibleFamily LM) :=
  ⟨fun x => Bool.false_ne_true ((compatible_LM_iff _ _ _ _ _).1 x.2)⟩

/-- System B has a compatible family over `![M, R]`: both values at `D` are `0`. -/
theorem nonempty_MR_B : Nonempty (sysB.CompatibleFamily MR) :=
  ⟨⟨fun i => point (MR i), (compatible_MR_iff _ _ _ _ _).2 rfl⟩⟩

/-- System B has no compatible family over `![L, M, R]`: the `LM` equation fails. -/
theorem isEmpty_LMR_B : IsEmpty (sysB.CompatibleFamily LMR) :=
  ⟨fun x => Bool.false_ne_true ((compatible_LMR_iff _ _ _ _ _).1 x.2).1⟩

/-! ### The witness table: attainable images -/

/-- `I_LM` of system A is everything: the only coarse family has the fine lift `point`, by the
image criterion. -/
theorem image_LM_A : φA.image LM = Set.univ :=
  Set.eq_univ_of_forall fun y =>
    (φA.mem_image_iff y).2
      ⟨fun i => point (LM i), (compatible_LM_iff _ _ _ _ _).2 rfl, fun _ => rfl⟩

/-- `I_MR` of system A is empty: there is no fine compatible family over `![M, R]`. -/
theorem image_MR_A : φA.image MR = ∅ := Set.range_eq_empty_iff.2 isEmpty_MR_A

/-- `I_LMR` of system A is empty: there is no fine compatible family over `![L, M, R]`. -/
theorem image_LMR_A : φA.image LMR = ∅ := Set.range_eq_empty_iff.2 isEmpty_LMR_A

/-- `I_LM` of system B is empty: there is no fine compatible family over `![L, M]`. -/
theorem image_LM_B : φB.image LM = ∅ := Set.range_eq_empty_iff.2 isEmpty_LM_B

/-- `I_MR` of system B is everything: the only coarse family has the fine lift `point`, by the
image criterion. -/
theorem image_MR_B : φB.image MR = Set.univ :=
  Set.eq_univ_of_forall fun y =>
    (φB.mem_image_iff y).2
      ⟨fun i => point (MR i), (compatible_MR_iff _ _ _ _ _).2 rfl, fun _ => rfl⟩

/-- `I_LMR` of system B is empty: there is no fine compatible family over `![L, M, R]`. -/
theorem image_LMR_B : φB.image LMR = ∅ := Set.range_eq_empty_iff.2 isEmpty_LMR_B

/-! ### Strict image restriction inclusion -/

/-- For system A, the naturality inclusion `restrict_(LMR,LM)(I_LMR) ⊆ I_LM` is strict: the left
side is empty and the right side is the singleton of coarse families. -/
theorem ssubset_restrict_image_LMR_A : coarse.restrict toLM '' φA.image LMR ⊂ φA.image LM :=
  (φA.image_restrict_subset toLM).ssubset_of_ne <| by
    rw [image_LMR_A, Set.image_empty, image_LM_A]
    exact Set.empty_ne_univ

/-- For system B, the naturality inclusion `restrict_(LMR,MR)(I_LMR) ⊆ I_MR` is strict. -/
theorem ssubset_restrict_image_LMR_B : coarse.restrict toMR '' φB.image LMR ⊂ φB.image MR :=
  (φB.image_restrict_subset toMR).ssubset_of_ne <| by
    rw [image_LMR_B, Set.image_empty, image_MR_B]
    exact Set.empty_ne_univ

/-- The induced map on attainable images `I_LMR → I_LM` of system A is not surjective: its source
is empty and its target is not. -/
theorem not_surjective_restrictImage_A : ¬Function.Surjective (φA.restrictImage toLM) := fun h =>
  let ⟨y, _⟩ := h ⟨default, Set.eq_univ_iff_forall.1 image_LM_A default⟩
  let ⟨x, _⟩ := y.2
  isEmpty_LMR_A.elim x

/-- The induced map on attainable images `I_LMR → I_MR` of system B is not surjective. -/
theorem not_surjective_restrictImage_B : ¬Function.Surjective (φB.restrictImage toMR) := fun h =>
  let ⟨y, _⟩ := h ⟨default, Set.eq_univ_iff_forall.1 image_MR_B default⟩
  let ⟨x, _⟩ := y.2
  isEmpty_LMR_B.elim x

/-! ### Full-family versus all-family content -/

/-- The two systems have the same full-family content: both `I_LMR` are empty. -/
theorem image_LMR_eq : φA.image LMR = φB.image LMR := image_LMR_A.trans image_LMR_B.symm

/-- The two systems have different `LM` content, as subsets of the same coarse family type. -/
theorem image_LM_ne : φA.image LM ≠ φB.image LM := by
  rw [image_LM_A, image_LM_B]
  exact Set.empty_ne_univ.symm

/-- The two systems have different `MR` content, as subsets of the same coarse family type. -/
theorem image_MR_ne : φA.image MR ≠ φB.image MR := by
  rw [image_MR_A, image_MR_B]
  exact Set.empty_ne_univ

end Amalgam.Models.Zigzag
