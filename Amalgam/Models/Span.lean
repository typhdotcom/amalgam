import Amalgam.Core.Reduction
import Amalgam.System.Binary
import Amalgam.System.Comparison
import Amalgam.System.Restriction

/-!
# Calibration case 1: two fine lifts, one observed class

The first finite calibration case on the binary shape `L → B ← R`: two distinct fine
compatible families over `![L, R]` are observed as the same coarse family and yield one observed
class.

The three-point preorder `Context` has `B ≤ L` and `B ≤ R`, and `B` is the greatest common coarser
context of `L` and `R`. The fine system `fine` has two states at `L` and one state at `B` and at
`R`; the coarse system `coarse` has one state everywhere, and the observation `φ : fine.Hom
coarse` is the unique map at every context. Over `![L, R]` the coarse compatible families form a
singleton `y₀`, while the fine compatible families are exactly `x₀` and `x₁`, distinguished by
their left state (`fineEquiv`). Both map to `y₀`, so the raw fiber over `y₀` is equivalent to
`Bool` (`fiberEquiv`, an explicit equivalence with both round trips), while the quotient fiber
over `y₀` is a singleton (`uniqueObservedFiber`), the observed classes of `x₀` and `x₁` agree
(`observed_x₀_eq_observed_x₁`), and there is exactly one observed class
(`uniqueObservedFamily`). The pullback picture of `Amalgam/Core/Reduction.lean` agrees through
`binaryEquiv`
(`map_binaryEquiv_x₀_eq`, `y₀_mem_image_of_inter_nonempty`).

No counting package is introduced; the two-element description of the fiber is the explicit
equivalence with `Bool`.
-/

namespace Amalgam.Models.Span

/-- The binary shape: two contexts `L`, `R` over a common coarser context `B`. -/
inductive Context
  /-- The left context. -/
  | L
  /-- The overlap, coarser than both. -/
  | B
  /-- The right context. -/
  | R

namespace Context

/-- The order generated by `B ≤ L`, `B ≤ R` and reflexivity, `c ≤ d` reading `c` coarser. -/
def le : Context → Context → Prop
  | B, _ => True
  | L, L => True
  | R, R => True
  | _, _ => False

instance : Preorder Context where
  le := le
  le_refl a := by cases a <;> trivial
  le_trans a b c _ _ := by cases a <;> cases b <;> cases c <;> trivial

/-- `B` is coarser than `L`. -/
theorem B_le_L : B ≤ L := trivial

/-- `B` is coarser than `R`. -/
theorem B_le_R : B ≤ R := trivial

/-- `B` is the greatest common coarser context of `L` and `R`. -/
theorem le_B_of_le_L_of_le_R : ∀ ⦃c : Context⦄, c ≤ L → c ≤ R → c ≤ B := by
  intro c _ _
  cases c <;> trivial

end Context

open Context

/-! ### The fine and coarse systems -/

/-- Fine state types: two states at `L`, one state at `B` and at `R`. -/
def FineState : Context → Type
  | L => Bool
  | B => Unit
  | R => Unit

/-- Fine restriction: the identity at `L` and at `R`, the unique map to `B`. -/
def fineRes : ∀ {c d : Context}, c ≤ d → FineState d → FineState c
  | L, L, _, x => x
  | L, B, h, _ => False.elim h
  | L, R, h, _ => False.elim h
  | B, _, _, _ => ()
  | R, R, _, x => x
  | R, L, h, _ => False.elim h
  | R, B, h, _ => False.elim h

/-- The fine restriction system. -/
def fine : RestrictionSystem Context where
  State := FineState
  res := fineRes
  res_refl := by
    intro c h x
    cases c <;> rfl
  res_trans := by
    intro c d e h₁ h₂ x
    cases c <;> cases d <;> cases e <;> first | rfl | exact False.elim h₁

/-- The coarse restriction system: one state at every context. -/
def coarse : RestrictionSystem Context where
  State _ := Unit
  res _ _ := ()
  res_refl _ _ := rfl
  res_trans _ _ _ := rfl

/-- The observation: the unique map at every context; naturality holds on the nose. -/
def φ : fine.Hom coarse where
  toFun _ _ := ()
  naturality _ _ := rfl

/-- The binary family `![L, R]`. -/
abbrev LR : Fin 2 → Context := ![L, R]

/-! ### Coarse families -/

/-- Over any family of contexts the coarse compatible families form a singleton. -/
instance uniqueCoarseFamily {ι : Type*} (F : ι → Context) : Unique (coarse.CompatibleFamily F) where
  default := ⟨fun _ => (), fun _ _ _ _ _ => rfl⟩
  uniq _ := Subtype.ext (funext fun _ => rfl)

/-- The unique coarse compatible family over `![L, R]`. -/
def y₀ : coarse.CompatibleFamily LR := default

/-! ### Fine families -/

/-- The fine family over `![L, R]` with left state `b`; compatible by `compatible_pair_iff` since
both states restrict to the single state at `B`. -/
def ofBool (b : Bool) : fine.CompatibleFamily LR :=
  ⟨Fin.cons b (Fin.cons () finZeroElim),
    (fine.compatible_pair_iff B_le_L B_le_R le_B_of_le_L_of_le_R _).2 rfl⟩

/-- The fine compatible families over `![L, R]` are exactly their left states. -/
def fineEquiv : fine.CompatibleFamily LR ≃ Bool where
  toFun x := x.1 0
  invFun := ofBool
  left_inv _ := Subtype.ext (funext (Fin.forall_fin_two.2 ⟨rfl, rfl⟩))
  right_inv _ := rfl

/-- The fine compatible family with left state `false`. -/
def x₀ : fine.CompatibleFamily LR := ofBool false

/-- The fine compatible family with left state `true`. -/
def x₁ : fine.CompatibleFamily LR := ofBool true

/-- The two fine families are distinct: their left states differ. -/
theorem x₀_ne_x₁ : x₀ ≠ x₁ := fun h => Bool.false_ne_true (congrArg fineEquiv h)

/-- Every fine compatible family over `![L, R]` is `x₀` or `x₁`. -/
theorem eq_x₀_or_eq_x₁ (x : fine.CompatibleFamily LR) : x = x₀ ∨ x = x₁ := by
  rw [← fineEquiv.symm_apply_apply x]
  cases fineEquiv x
  · exact Or.inl rfl
  · exact Or.inr rfl

/-! ### The raw fiber over `y₀` -/

/-- Every fine family is observed as `y₀`, the only coarse family. -/
theorem mapFamily_eq_y₀ (x : fine.CompatibleFamily LR) : φ.mapFamily LR x = y₀ :=
  Subsingleton.elim _ _

/-- `x₀` is observed as `y₀`. -/
theorem mapFamily_x₀ : φ.mapFamily LR x₀ = y₀ := mapFamily_eq_y₀ x₀

/-- `x₁` is observed as `y₀`. -/
theorem mapFamily_x₁ : φ.mapFamily LR x₁ = y₀ := mapFamily_eq_y₀ x₁

/-- The raw fiber over `y₀` has exactly two elements: it is the fine families, read by their left
state. -/
def fiberEquiv : {x // φ.mapFamily LR x = y₀} ≃ Bool where
  toFun x := x.1.1 0
  invFun b := ⟨ofBool b, mapFamily_eq_y₀ _⟩
  left_inv x := Subtype.ext (fineEquiv.left_inv x.1)
  right_inv _ := rfl

/-- `fiberEquiv` reads `x₀` as `false`. -/
@[simp] theorem fiberEquiv_x₀ : fiberEquiv ⟨x₀, mapFamily_x₀⟩ = false := rfl

/-- `fiberEquiv` reads `x₁` as `true`. -/
@[simp] theorem fiberEquiv_x₁ : fiberEquiv ⟨x₁, mapFamily_x₁⟩ = true := rfl

/-- `fiberEquiv.symm false` is `x₀`. -/
@[simp] theorem fiberEquiv_symm_false : (fiberEquiv.symm false).1 = x₀ := rfl

/-- `fiberEquiv.symm true` is `x₁`. -/
@[simp] theorem fiberEquiv_symm_true : (fiberEquiv.symm true).1 = x₁ := rfl

/-- Round trip: reading a fine lift and rebuilding it. -/
theorem fiberEquiv_symm_apply_apply (x : {x // φ.mapFamily LR x = y₀}) :
    fiberEquiv.symm (fiberEquiv x) = x :=
  fiberEquiv.symm_apply_apply x

/-- Round trip: rebuilding a fine lift from a left state and reading it. -/
theorem fiberEquiv_apply_symm_apply (b : Bool) : fiberEquiv (fiberEquiv.symm b) = b :=
  fiberEquiv.apply_symm_apply b

/-! ### The quotient fiber over `y₀` -/

/-- `x₀` and `x₁` have the same observed class: all observed components agree. -/
theorem observed_x₀_eq_observed_x₁ :
    (Quotient.mk _ x₀ : φ.ObservedFamily LR) = Quotient.mk _ x₁ :=
  (φ.observedFamily_mk_eq_iff x₀ x₁).2 fun _ => rfl

/-- There is exactly one observed class over `![L, R]`, the class of `x₀`: the injection
`observedMapFamily` lands in the singleton of coarse families. -/
instance uniqueObservedFamily : Unique (φ.ObservedFamily LR) where
  default := Quotient.mk _ x₀
  uniq _ := φ.observedMapFamily_injective (Subsingleton.elim _ _)

/-- The quotient fiber over `y₀` is inhabited, by shared inhabitedness with the raw fiber. -/
theorem nonempty_observedFiber : Nonempty {q // φ.observedMapFamily LR q = y₀} :=
  (φ.nonempty_fiber_mapFamily_iff_nonempty_fiber_observedMapFamily y₀).1 ⟨⟨x₀, mapFamily_x₀⟩⟩

/-- The quotient fiber over `y₀` is a subsingleton, as every quotient fiber is. -/
theorem subsingleton_observedFiber : Subsingleton {q // φ.observedMapFamily LR q = y₀} :=
  φ.subsingleton_fiber_observedMapFamily y₀

/-- The quotient fiber over `y₀` is a singleton: the class of `x₀`, which is also the class of
`x₁`. -/
instance uniqueObservedFiber : Unique {q // φ.observedMapFamily LR q = y₀} where
  default := ⟨Quotient.mk _ x₀, mapFamily_x₀⟩
  uniq q := @Subsingleton.elim _ subsingleton_observedFiber q _

/-! ### Agreement with the pullback picture -/

/-- Under `binaryEquiv`, the reduction comparison `Function.Pullback.map` sends the pairs of `x₀`
and `x₁`
to the same coarse pair. -/
theorem map_binaryEquiv_x₀_eq :
    Function.Pullback.map (φ.naturality B_le_L) (φ.naturality B_le_R)
        (fine.binaryEquiv B_le_L B_le_R le_B_of_le_L_of_le_R x₀) =
      Function.Pullback.map (φ.naturality B_le_L) (φ.naturality B_le_R)
        (fine.binaryEquiv B_le_L B_le_R le_B_of_le_L_of_le_R x₁) := by
  rw [← φ.binaryEquiv_mapFamily, ← φ.binaryEquiv_mapFamily, mapFamily_x₀, mapFamily_x₁]

/-- `y₀` is attained, by the intersection criterion: the fine overlap value `()` is reached from
the left state `false` and from the right state. -/
theorem y₀_mem_image_of_inter_nonempty : y₀ ∈ φ.image LR :=
  (φ.mem_range_mapFamily_iff_inter_nonempty B_le_L B_le_R le_B_of_le_L_of_le_R y₀).2
    ⟨(), ⟨false, rfl, rfl⟩, (), rfl, rfl⟩

end Amalgam.Models.Span
