import Amalgam.System.Restriction
import Mathlib.Data.Fin.VecNotation

/-!
# The zigzag shape `L → B ← M → D ← R`

The five-point preorder of the shared-overlap shape, with `B ≤ L`, `B ≤ M`, `D ≤ M`, `D ≤ R`,
reflexivity, and no other relations (`c ≤ d` reads `c` coarser than `d`). `B` is the greatest
common coarser context of `L` and `M`, `D` that of `M` and `R`, and `L`, `R` have no common
coarser context.

The declared admissible families are the eight subfamilies of the local views `L`, `M`, `R`,
presented on `Fin n` in the order `L, M, R`:

```text
empty, single L, single M, single R, LM, LR, MR, LMR
```

The declared operations are the forgetful restrictions along inclusions, with reflexive context
inequalities: from `LMR` to each pair and each single view, from each pair to its two views, and
from every family to the empty family. Overlap contexts `B`, `D` belong to the systems and the
compatibility conditions; they are not local views of this collection.

Concrete systems on this shape live in `Amalgam/Models/`; the generic classification of the
attainable images on it lives in `Amalgam/System/`.
-/

namespace Zigzag

/-- The shared-overlap shape `L → B ← M → D ← R`. -/
inductive Context
  /-- The left context. -/
  | L
  /-- The overlap of `L` and `M`. -/
  | B
  /-- The middle context. -/
  | M
  /-- The overlap of `M` and `R`. -/
  | D
  /-- The right context. -/
  | R

namespace Context

/-- The order generated by `B ≤ L`, `B ≤ M`, `D ≤ M`, `D ≤ R` and reflexivity, `c ≤ d` reading
`c` coarser. -/
def le : Context → Context → Prop
  | L, L => True
  | B, B => True
  | B, L => True
  | B, M => True
  | M, M => True
  | D, D => True
  | D, M => True
  | D, R => True
  | R, R => True
  | _, _ => False

instance : Preorder Context where
  le := le
  le_refl a := by cases a <;> trivial
  le_trans a b c _ _ := by cases a <;> cases b <;> cases c <;> trivial

/-- `B` is coarser than `L`. -/
theorem B_le_L : B ≤ L := trivial

/-- `B` is coarser than `M`. -/
theorem B_le_M : B ≤ M := trivial

/-- `D` is coarser than `M`. -/
theorem D_le_M : D ≤ M := trivial

/-- `D` is coarser than `R`. -/
theorem D_le_R : D ≤ R := trivial

/-- `B` is the greatest common coarser context of `L` and `M`. -/
theorem le_B_of_le_L_of_le_M : ∀ ⦃c : Context⦄, c ≤ L → c ≤ M → c ≤ B := by
  intro c _ _
  cases c <;> trivial

/-- `D` is the greatest common coarser context of `M` and `R`. -/
theorem le_D_of_le_M_of_le_R : ∀ ⦃c : Context⦄, c ≤ M → c ≤ R → c ≤ D := by
  intro c _ _
  cases c <;> trivial

/-- `L` and `R` have no common coarser context. -/
theorem not_le_L_of_le_R : ∀ ⦃c : Context⦄, c ≤ L → c ≤ R → False := by
  intro c _ _
  cases c <;> trivial

/-- Vacuously, every common coarser context of `L` and `R` lies below `M`. -/
theorem le_M_of_le_L_of_le_R : ∀ ⦃c : Context⦄, c ≤ L → c ≤ R → c ≤ M :=
  fun _ hL hR => (not_le_L_of_le_R hL hR).elim

end Context

open Context

/-! ### The admissible families -/

/-- The empty family. -/
abbrev empty : Fin 0 → Context := ![]

/-- The family with the single view `c`. -/
abbrev single (c : Context) : Fin 1 → Context := ![c]

/-- The family `![L, M]`. -/
abbrev LM : Fin 2 → Context := ![L, M]

/-- The family `![M, R]`. -/
abbrev MR : Fin 2 → Context := ![M, R]

/-- The full family `![L, M, R]`. -/
abbrev LMR : Fin 3 → Context := ![L, M, R]

/-- The declared restriction operation forgetting the view `R`. -/
def toLM : FamilyMap LMR LM :=
  ⟨![0, 1], fun k => match k with | 0 => le_rfl | 1 => le_rfl⟩

/-- The declared restriction operation forgetting the view `L`. -/
def toMR : FamilyMap LMR MR :=
  ⟨![1, 2], fun k => match k with | 0 => le_rfl | 1 => le_rfl⟩

/-- The family `![L, R]` of the two outer views. -/
abbrev LR : Fin 2 → Context := ![L, R]

/-! ### The declared forgetful operations -/

/-- Forgetting the view `M`. -/
def toLR : FamilyMap LMR LR :=
  ⟨![0, 2], fun k => match k with | 0 => le_rfl | 1 => le_rfl⟩

/-- Restricting the full family to the single view `L`. -/
def LMR.toL : FamilyMap LMR (single L) := ⟨![0], fun k => match k with | 0 => le_rfl⟩

/-- Restricting the full family to the single view `M`. -/
def LMR.toM : FamilyMap LMR (single M) := ⟨![1], fun k => match k with | 0 => le_rfl⟩

/-- Restricting the full family to the single view `R`. -/
def LMR.toR : FamilyMap LMR (single R) := ⟨![2], fun k => match k with | 0 => le_rfl⟩

/-- Restricting `LM` to the view `L`. -/
def LM.toL : FamilyMap LM (single L) := ⟨![0], fun k => match k with | 0 => le_rfl⟩

/-- Restricting `LM` to the view `M`. -/
def LM.toM : FamilyMap LM (single M) := ⟨![1], fun k => match k with | 0 => le_rfl⟩

/-- Restricting `LR` to the view `L`. -/
def LR.toL : FamilyMap LR (single L) := ⟨![0], fun k => match k with | 0 => le_rfl⟩

/-- Restricting `LR` to the view `R`. -/
def LR.toR : FamilyMap LR (single R) := ⟨![1], fun k => match k with | 0 => le_rfl⟩

/-- Restricting `MR` to the view `M`. -/
def MR.toM : FamilyMap MR (single M) := ⟨![0], fun k => match k with | 0 => le_rfl⟩

/-- Restricting `MR` to the view `R`. -/
def MR.toR : FamilyMap MR (single R) := ⟨![1], fun k => match k with | 0 => le_rfl⟩

/-- Forgetting every view of a family. -/
def toEmpty {n : ℕ} (F : Fin n → Context) : FamilyMap F empty := ⟨Fin.elim0, fun k => Fin.elim0 k⟩

end Zigzag
